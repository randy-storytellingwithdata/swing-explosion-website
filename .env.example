# Copy this file to .env.local for local development, and add the same
# values in the Vercel project settings for production.

# Formspree form endpoint ID (from https://formspree.io) used by the
# booking/contact forms. Example value: "abcdwxyz"
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Published Google Sheet, exported as CSV, used to power the Events page.
# In Google Sheets: File > Share > Publish to web > select the sheet tab >
# CSV, then paste the resulting URL here.
GOOGLE_SHEET_EVENTS_CSV_URL=
